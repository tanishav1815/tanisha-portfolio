# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Google Maps API Integration (Used by client/src/components/Map.tsx)
VITE_FRONTEND_FORGE_API_KEY=your-maps-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Umami Analytics integration (Used by client/index.html script loading)
VITE_ANALYTICS_ENDPOINT=https://your-analytics-domain.com
VITE_ANALYTICS_WEBSITE_ID=your-website-uuid

# OAuth Login Portal (Used by client/src/const.ts)
VITE_OAUTH_PORTAL_URL=https://auth.example.com
VITE_APP_ID=your-oauth-app-id
